# Multi-stage build for faster builds
FROM node:18-slim as base

# Install system dependencies (cache this layer)
RUN apt-get update && apt-get install -y \
    curl \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Python stage
FROM base as python-stage
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir ultralytics

# Node stage  
FROM python-stage as node-stage
WORKDIR /app

# Copy package files first (for better caching)
COPY mcp_vision_adapter/package*.json ./
RUN npm ci --only=production --no-audit --no-fund

# Final stage
FROM node-stage as final
COPY mcp_vision_adapter/ ./
COPY test.jpg ./

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Start the server
CMD ["node", "vision-mcp-server-sse.js"]
